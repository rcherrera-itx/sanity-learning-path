# Public
NEXT_PUBLIC_SANITY_PROJECT=your-project-id
NEXT_PUBLIC_SANITY_DATASET=your-dataset
NEXT_PUBLIC_SANITY_STUDIO_URL=your-studio-url

# Browser-exposed only during Draft Mode
SANITY_API_BROWSER_TOKEN=your-sanity-api-browser-token

# Private
SANITY_API_READ_TOKEN=your-viewer-token
SANITY_REVALIDATE_SECRET=your-revalidation-secret(openssl rand -base64 32)
SHOPIFY_STORE_DOMAIN=your-shopify-url
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-shopify-token
SHOPIFY_STOREFRONT_PUBLIC_ACCESS_TOKEN=your-shopify-public-access-token
SHOPIFY_APP_CLIENT_SECRET=your-shopify-app-client-secret